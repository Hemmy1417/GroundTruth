# ── Chain (public — baked into the client bundle at build time) ──────────────
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999

# ── Firebase client SDK (public — used ONLY for realtime Firestore reads) ────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (SERVER ONLY — API routes; never NEXT_PUBLIC_) ────────────
# Service-account JSON, base64-encoded (one line):
#   node -e "console.log(Buffer.from(require('fs').readFileSync('sa.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Server-side RPC for the /api/rpc proxy ───────────────────────────────────
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# ── Sessions (HMAC key for SIWE session cookies; 32+ random bytes hex) ───────
SESSION_SECRET=

# ── Demo control (reserved; NOT currently enforced — safe to leave blank) ────
DEMO_ADMIN_TOKEN=
